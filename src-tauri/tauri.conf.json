{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VKDex",
  "version": "0.3.2",
  "identifier": "com.vokaerian.vkdex",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VKDex",
        "width": 360,
        "height": 800,
        "minWidth": 360,
        "minHeight": 800,
        "resizable": true,
        "backgroundColor": "#1b1b1b"
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
